# Google Analytics 4 — Measurement ID de la propiedad (formato G-XXXXXXXXXX).
# Copia este archivo a .env.local y pon el ID real para activar la analítica.
# Sin esta variable el sitio funciona igual: no carga gtag.js ni escribe cookies.
VITE_GA4_ID=

# Endpoint que recibe los leads del formulario de clase de prueba.
# Es el /exec de un Apps Script con doPost; el código está en docs/LEADS.md.
# Sin esta variable el formulario funciona igual, pero nada queda registrado.
VITE_LEADS_ENDPOINT=
